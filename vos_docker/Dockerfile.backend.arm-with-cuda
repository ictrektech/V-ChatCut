ARG NODE_BASE_IMAGE=swr.cn-southwest-2.myhuaweicloud.com/ictrek/node:arm_24-bookworm-slim

FROM ${NODE_BASE_IMAGE} AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY . .
ARG VITE_BASE_PATH=/app/com.ictrek.v-chatcut/
ENV VITE_BASE_PATH=${VITE_BASE_PATH}
RUN npm run sync:mediapipe \
    && npm run verify:server-tool-catalog \
    && npx tsc -b \
    && npx vite build --config config/vite.config.ts \
    && npx esbuild vos_docker/server.ts --bundle --platform=node --format=esm --packages=external --outfile=vos-dist/server.mjs

FROM ${NODE_BASE_IMAGE}
ENV NODE_ENV=production \
    PORT=5199 \
    OPENCHATCUT_BIND_HOST=0.0.0.0 \
    OPENCHATCUT_PROFILE=arm-with-cuda \
    OPENCHATCUT_DATA_DIR=/data \
    OPENCHATCUT_TRUST_PROXY=true \
    OPENCHATCUT_H264_ENCODER=h264_nvenc \
    OPENCHATCUT_FFMPEG=/usr/bin/ffmpeg \
    OPENCHATCUT_FFPROBE=/usr/bin/ffprobe \
    CC_BROWSER_EXECUTABLE=/usr/bin/chromium \
    CC_RENDER_GL=angle-egl \
    NVIDIA_VISIBLE_DEVICES=all \
    NVIDIA_DRIVER_CAPABILITIES=compute,utility,video,graphics
WORKDIR /app
ARG DEBIAN_MIRROR=http://repo.huaweicloud.com/debian
ARG DEBIAN_SECURITY_MIRROR=http://repo.huaweicloud.com/debian-security
RUN sed -i \
      -e "s|http://deb.debian.org/debian-security|${DEBIAN_SECURITY_MIRROR}|g" \
      -e "s|http://deb.debian.org/debian|${DEBIAN_MIRROR}|g" \
      /etc/apt/sources.list.d/debian.sources \
    && apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates chromium curl dumb-init ffmpeg fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json ./
RUN ONNXRUNTIME_NODE_INSTALL=skip ONNXRUNTIME_NODE_INSTALL_CUDA=skip npm ci --omit=dev \
    && npm cache clean --force
COPY --from=build /app/dist ./dist
COPY --from=build /app/vos-dist ./vos-dist
COPY assets ./assets
COPY config ./config
COPY public ./public
COPY remotion ./remotion
COPY server ./server
COPY shared ./shared
COPY skills ./skills
COPY src ./src
COPY tsconfig*.json ./
RUN mkdir -p /data/media/uploads && chown -R node:node /data
USER node
EXPOSE 5199
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD curl --fail --silent http://127.0.0.1:5199/ >/dev/null || exit 1
ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "vos-dist/server.mjs"]
