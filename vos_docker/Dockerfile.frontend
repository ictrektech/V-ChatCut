ARG NODE_BASE_IMAGE
ARG NGINX_BASE_IMAGE

FROM ${NODE_BASE_IMAGE} AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY . .
ARG VITE_BASE_PATH=/app/com.ictrek.v-chatcut/
ARG VOS_APP_VERSION
ENV VITE_BASE_PATH=${VITE_BASE_PATH}
ENV VOS_APP_VERSION=${VOS_APP_VERSION}
RUN npm run sync:mediapipe \
    && npm run verify:server-tool-catalog \
    && npx tsc -b \
    && npx vite build --config config/vite.config.ts

FROM ${NGINX_BASE_IMAGE}
COPY vos_docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1/ || exit 1
CMD ["nginx", "-g", "daemon off;"]
